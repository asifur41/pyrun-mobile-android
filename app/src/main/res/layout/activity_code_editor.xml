<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editor_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/gutter_bg"
        app:title="@string/app_name"
        app:titleTextColor="@color/editor_fg"
        app:subtitleTextColor="@color/gutter_fg" />

    <com.pyrun.mobile.editor.CodeEditorView
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAutofill="no" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gutter_bg"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/quickBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/consolePanel"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@color/console_bg"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/gutter_bg"
            android:orientation="horizontal"
            android:padding="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/console"
                android:textColor="@color/gutter_fg" />
            <TextView
                android:id="@+id/consoleClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="@string/clear"
                android:textColor="@color/editor_fg" />
            <TextView
                android:id="@+id/consoleClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:text="✕"
                android:textColor="@color/editor_fg" />
        </LinearLayout>
        <ScrollView
            android:id="@+id/consoleScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/consoleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textColor="@color/editor_fg"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
